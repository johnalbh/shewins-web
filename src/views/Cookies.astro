---
// Generated from html/cookies.html + html/es/cookies.html by scripts/migrate-from-html.mjs.
import Base from '../layouts/Base.astro';
import { localize, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L, u } = localize(lang);
---

<Base lang={lang} route="cookies">
<div class="page on" id="p-cookies">
<section class="s-cream post-head"><div class="w"><a class="back" href={u("/")}>← <span class={lang}>{L("Home", "Inicio")}</span></a>
<p class="lab" style="margin-top:34px"><span class={lang}>Legal</span> · <span class={lang}>{L("Updated October 2026", "Actualizado en octubre de 2026")}</span></p>
<h1><span class={lang}>{L("Cookie policy", "Política de cookies")}</span></h1></div></section>
<section class="s-cream"><div class="w"><article class="post"><div class={lang}>
<p>{L("This policy follows article 22.2 of Spanish Law 34/2002 (LSSI-CE) and the GDPR. A cookie is a small file stored on your device. Similar technologies, such as local storage, are covered too.", "Esta política sigue el artículo 22.2 de la Ley 34/2002 (LSSI-CE) y el RGPD. Una cookie es un pequeño archivo que se guarda en tu dispositivo. También se incluyen tecnologías similares, como el almacenamiento local.")}</p>
<h2>{L("What we use today", "Qué usamos hoy")}</h2>
<table class="ctab"><thead><tr><th>{L("Name", "Nombre")}</th><th>{L("Type", "Tipo")}</th><th>{L("Purpose", "Finalidad")}</th><th>{L("Duration", "Duración")}</th></tr></thead><tbody>
<tr><td>sw-lang</td><td>{L("Technical (local storage)", "Técnica (almacenamiento local)")}</td><td>{L("Remembers your language, English or Spanish.", "Recuerda tu idioma, inglés o español.")}</td><td>{L("Until you clear it", "Hasta que la borres")}</td></tr>
<tr><td>sw-consent</td><td>{L("Technical (local storage)", "Técnica (almacenamiento local)")}</td><td>{L("Remembers your cookie choice.", "Recuerda tu elección sobre cookies.")}</td><td>{L("12 months", "12 meses")}</td></tr>
</tbody></table>
<p>{L("These are strictly necessary for the site to work as you asked, so they do not need consent. ", "Son estrictamente necesarias para que el sitio funcione como has pedido, por lo que no requieren consentimiento. ")}<strong>{L("We do not use analytics, advertising or tracking cookies at the moment.", "De momento no usamos cookies de analítica, publicidad ni seguimiento.")}</strong></p>
<h2>{L("If we add other cookies", "Si añadimos otras cookies")}</h2>
<p>{L("Analytics, marketing or similar cookies will only be set after you accept them in the cookie banner. They will be off by default, and rejecting them will be as easy as accepting them.", "Las cookies de analítica, marketing o similares solo se instalarán después de que las aceptes en el aviso de cookies. Estarán desactivadas por defecto y rechazarlas será tan fácil como aceptarlas.")}</p>
<h2>{L("Third-party services", "Servicios de terceros")}</h2>
<p>{L("Links to Meetup, Instagram and LinkedIn open their own sites, which have their own cookie policies.", "Los enlaces a Meetup, Instagram y LinkedIn abren sus propios sitios, que tienen sus propias políticas de cookies.")}</p>
<h2>{L("Manage your choice", "Gestiona tu elección")}</h2>
<p>{L("You can change your choice at any time with “Cookie settings” in the footer. You can also delete or block cookies in your browser settings.", "Puedes cambiar tu elección en cualquier momento con «Configurar cookies» en el pie de página. También puedes borrar o bloquear cookies en los ajustes de tu navegador.")}</p></div></article></div></section>
</div>
</Base>
