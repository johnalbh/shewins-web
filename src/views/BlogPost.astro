---
// Blog article page, same markup as html/blog/*.html. Content comes from src/content/posts.
import Base from '../layouts/Base.astro';
import ShareArticle from '../components/blog/ShareArticle.astro';
import '../styles/article.css';
import { SITE, localize, type Lang } from '../i18n';
import { getPosts, type Post } from '../lib/content';
import { renderMarkdoc } from '../lib/markdoc';

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
const { L, u } = localize(lang);
const posts = await getPosts();
const next = posts[(posts.findIndex((p) => p.slug === post.slug) + 1) % posts.length];

const path = `/blog/${post.slug}`;
const url = SITE + u(path);
const title = L(post.title, post.titleEs);
const description = L(post.excerptEn, post.excerptEs);
const author = post.authorEntry?.name ?? '';
const role = L(post.authorEntry?.roleEn, post.authorEntry?.roleEs);
const body = renderMarkdoc(L(post.bodyEn.node, post.bodyEs.node), lang);

const seo = {
  title: `${title} | ${L('SheWins Blog', 'Blog de SheWins')}`,
  description,
  ogType: 'article',
  jsonLd: {
    '@context': 'https://schema.org',
    '@graph': [
      { '@id': `${SITE}/#org`, '@type': 'Organization', name: 'SheWins', url: `${SITE}/` },
      {
        '@type': 'BlogPosting',
        headline: title,
        description,
        inLanguage: lang,
        url,
        mainEntityOfPage: url,
        image: `${SITE}/assets/og-image.jpg`,
        datePublished: post.publishedAt,
        author: { '@type': 'Person', name: author },
        publisher: { '@id': `${SITE}/#org` },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'SheWins', item: SITE + (lang === 'es' ? '/es' : '/') },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + u('/blog') },
          { '@type': 'ListItem', position: 3, name: title, item: url },
        ],
      },
    ],
  },
};
---

<Base lang={lang} route={`post-${post.slug}`} seo={seo} path={path}>
<div class="read-progress" aria-hidden="true"></div>
<div class="page on" id={`p-post-${post.slug}`}>
<section class="s-cream post-head"><div class="w post-grid"><div class="post-rail-head"><a class="back" href={u('/blog')}><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16"><path d="M14 8H3M7 3.5 2.5 8 7 12.5"></path></svg><span class={lang}>Blog</span></a></div><div class="post-title"><p class="lab"><span class={lang}>{L('By', 'Por')}</span> {author} · {post.readingTime} <span class={lang}>{L('min read', 'min de lectura')}</span></p> <h1><span class={lang}>{title}</span></h1></div></div></section>
<section class="s-cream post-body"><div class="w post-grid"><article class="post"><div class={lang}><Fragment set:html={body} /></div><div class="byline"><p class="lab"><span class={lang}>{L('Written by', 'Escrito por')}</span></p><p class="nm">{author}</p>{role && <p class="lab" style="margin-top:6px"><span class={lang}>{role}</span></p>}</div></article><aside class="post-rail" aria-label={L('About this article', 'Sobre este artículo')}><div class="post-author"><p class="lab"><span class={lang}>{L('Written by', 'Escrito por')}</span></p><p class="nm">{author}</p>{role && <p class="role"><span class={lang}>{role}</span></p>}<p class="role">{post.readingTime} <span class={lang}>{L('min read', 'min de lectura')}</span></p></div><ShareArticle lang={lang} url={url} title={title} description={description} /></aside></div></section>
<section class="s-white nextp"><div class="w"><p class="lab"><span class={lang}>{L('Next article', 'Siguiente artículo')}</span></p><a class="prow" href={u(`/blog/${next.slug}`)}><div class="lab">{next.authorEntry?.name}</div><div><h3><span class={lang}>{L(next.title, next.titleEs)}</span></h3><span class="go"><i><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></i><span class={lang}>{L('Read article', 'Leer artículo')}</span></span></div></a></div></section>
</div>
</Base>
