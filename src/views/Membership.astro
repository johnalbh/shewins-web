---
// Generated from html/membership.html + html/es/membership.html by scripts/migrate-from-html.mjs.
import Base from '../layouts/Base.astro';
import { localize, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L, u } = localize(lang);
---

<Base lang={lang} route="membership">
<div class="page on" id="p-membership">
<section class="open o-grad"><div aria-hidden="true" class="n">03</div><div class="t"><h1><span class={lang}>{L("Free is the front door. Membership is home.", "Lo gratuito es la puerta. La membresía es tu casa.")}</span></h1><p class="lead"><span class={lang}>{L("A community for women who want to connect, grow and move forward, together.", "Una comunidad para mujeres que quieren conectar, crecer y avanzar, juntas.")}</span></p><div class="btns"><button class="btn b-cream" data-scroll="waitlist" type="button"><span class={lang}>{L("Join the waitlist", "Unirme a la lista de espera")}</span><span class="ar"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></button><span class="pill"><span class={lang}>{L("Opening soon", "Abre pronto")}</span></span></div></div></section>
<section class="sec s-cream"><div class="w"><div class="head"><p class="lab"><span class={lang}>{L("Why stay", "Por qué quedarte")}</span></p><h2 class="l" style="max-width:16ch"><span class={lang}>{L("Because SheWins helps you keep moving forward.", "Porque SheWins te ayuda a seguir avanzando.")}</span></h2></div><p class="lead" style="font-size:clamp(18px,1.8vw,22px);max-width:50ch"><span class={lang}>{L("With the right people, the right opportunities and practical support around you. Not more events. More belonging.", "Con las personas adecuadas, las oportunidades adecuadas y apoyo práctico a tu alrededor. No más eventos. Más pertenencia.")}</span></p></div></section>
<section class="sec s-white" style="padding-top:clamp(40px,6vw,80px)"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L("Four pillars", "Cuatro pilares")}</span></p></div>
<div class="rw"><p class="lab"><span class={lang}>{L("Belong", "Pertenece")}</span></p><div><h3><span class={lang}>{L("A community that feels intentional, not noisy.", "Una comunidad intencional, no ruidosa.")}</span></h3><ul class="d"><li><span class={lang}>{L("Private members-only community", "Comunidad privada solo para miembros")}</span></li><li><span class={lang}>{L("Member directory and introductions", "Directorio de miembros e introducciones")}</span></li><li><span class={lang}>{L("A monthly members gathering", "Un encuentro mensual de miembros")}</span></li></ul></div></div>
<div class="rw"><p class="lab"><span class={lang}>{L("Grow", "Crece")}</span></p><div><h3><span class={lang}>{L("Practical learning for real-life challenges.", "Aprendizaje práctico para retos reales.")}</span></h3><ul class="d"><li><span class={lang}>{L("A members-only session every month", "Una sesión mensual solo para miembros")}</span></li><li><span class={lang}>{L("Pricing, negotiating, LinkedIn, public speaking", "Precios, negociación, LinkedIn, hablar en público")}</span></li><li><span class={lang}>{L("Always: what can I do differently after this?", "Siempre: ¿qué puedo hacer distinto después?")}</span></li></ul></div></div>
<div class="rw"><p class="lab"><span class={lang}>{L("Connect", "Conecta")}</span></p><div><h3><span class={lang}>{L("The right person at the right moment.", "La persona adecuada en el momento adecuado.")}</span></h3><ul class="d"><li><span class={lang}>{L("Q&As and expert office hours", "Q&A y horas con expertas")}</span></li><li><span class={lang}>{L("Mentor and founder conversations", "Conversaciones con mentoras y fundadoras")}</span></li><li><span class={lang}>{L("Partner opportunities and invitations", "Oportunidades con partners e invitaciones")}</span></li></ul></div></div>
<div class="rw"><p class="lab"><span class={lang}>{L("Move", "Avanza")}</span></p><div><h3><span class={lang}>{L("Turn connection and learning into action.", "Convierte conexión y aprendizaje en acción.")}</span></h3><ul class="d"><li><span class={lang}>{L("One thing learned", "Una cosa aprendida")}</span></li><li><span class={lang}>{L("One useful connection", "Una conexión útil")}</span></li><li><span class={lang}>{L("One concrete action, every month", "Una acción concreta, cada mes")}</span></li></ul></div></div>
</div></section>
<section class="sec s-cream"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L("The rhythm", "El ritmo")}</span></p><h2 class="l"><span class={lang}>{L("Simple on purpose.", "Sencillo a propósito.")}</span></h2></div>
<div class="start">
<div><b class="k">1×</b><h3><span class={lang}>{L("Growth session", "Sesión de crecimiento")}</span></h3><p><span class={lang}>{L("A practical workshop or masterclass, every month.", "Un taller o masterclass práctico, cada mes.")}</span></p></div>
<div><b class="k">1×</b><h3><span class={lang}>{L("Connection moment", "Momento de conexión")}</span></h3><p><span class={lang}>{L("A small-group coffee, online circle or coworking, every month.", "Un café en grupo pequeño, círculo online o coworking, cada mes.")}</span></p></div>
<div><b class="k">1×</b><h3><span class={lang}>{L("Curated opportunity", "Oportunidad seleccionada")}</span></h3><p><span class={lang}>{L("An expert, mentor, partner or ecosystem opportunity, every month.", "Una oportunidad con una experta, mentora, partner o del ecosistema, cada mes.")}</span></p></div>
<div><b class="k">↻</b><h3><span class={lang}>{L("Members Circle", "Círculo de miembros")}</span></h3><p><span class={lang}>{L("Every quarter: reflect, set goals, share challenges and celebrate wins.", "Cada trimestre: reflexionar, fijar metas, compartir retos y celebrar logros.")}</span></p></div>
</div>
</div></section>
<section class="sec s-pink"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L("Clear expectations", "Expectativas claras")}</span></p><h2 class="l" style="max-width:12ch"><span class={lang}>{L("What is included, and what is not.", "Qué incluye y qué no.")}</span></h2></div>
<div class="incl">
<div class="yes"><span class="script"><span class={lang}>{L("Included", "Incluido")}</span></span><ul class="ck">
<li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Private community", "Comunidad privada")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Member directory", "Directorio de miembros")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Monthly members-only growth session", "Sesión mensual de crecimiento solo para miembros")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Monthly connection experience", "Experiencia mensual de conexión")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Member introductions", "Introducciones entre miembros")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Exclusive opportunities", "Oportunidades exclusivas")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Member spotlights", "Miembros destacadas")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Priority access to selected events", "Acceso prioritario a eventos seleccionados")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Discounts on selected workshops and Academy programmes", "Descuentos en talleres y programas de Academy seleccionados")}</span></li><li><svg aria-hidden="true" viewBox="0 0 40 32"><path d="M4 18 L15 28 L36 4"></path></svg><span class={lang}>{L("Quarterly Members Circle", "Círculo trimestral de miembros")}</span></li></ul></div>
<div class="no"><span class="script"><span class={lang}>{L("Not included", "No incluido")}</span></span><ul class="ck">
<li><span class={lang}>{L("Unlimited 1:1 mentoring", "Mentoría 1:1 ilimitada")}</span></li><li><span class={lang}>{L("Unlimited access to experts", "Acceso ilimitado a expertas")}</span></li><li><span class={lang}>{L("Full Academy programmes", "Programas completos de Academy")}</span></li><li><span class={lang}>{L("Every workshop for free", "Todos los talleres gratis")}</span></li><li><span class={lang}>{L("Unlimited events", "Eventos ilimitados")}</span></li></ul></div>
</div>
</div></section>
<section class="sec s-cream"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L("Your first month", "Tu primer mes")}</span></p><h2 class="l" style="max-width:14ch"><span class={lang}>{L("You will not just be welcomed. You will start moving.", "No solo te damos la bienvenida. Empiezas a avanzar.")}</span></h2></div>
<div class="start">
<div><b class="k">01</b><h3><span class={lang}>{L("Meet someone", "Conoce a alguien")}</span></h3><p><span class={lang}>{L("We introduce you to one woman who could be relevant to you.", "Te presentamos a una mujer que puede ser relevante para ti.")}</span></p></div>
<div><b class="k">02</b><h3><span class={lang}>{L("Join something", "Únete a algo")}</span></h3><p><span class={lang}>{L("Choose one upcoming event or session based on your interests.", "Elige un evento o sesión próximos según tus intereses.")}</span></p></div>
<div><b class="k">03</b><h3><span class={lang}>{L("Take one action", "Da un paso")}</span></h3><p><span class={lang}>{L("Choose one small goal to move forward this month.", "Elige una meta pequeña para avanzar este mes.")}</span></p></div>
</div>
</div></section>
<section class="sec s-white"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L("Questions", "Preguntas")}</span></p><h2 class="l"><span class={lang}>{L("Good to know.", "Bueno saber.")}</span></h2></div>
<details><summary><span class={lang}>{L("Is this another WhatsApp group?", "¿Es otro grupo de WhatsApp?")}</span></summary><p><span class={lang}>{L("No. The community is intentional, not noisy. The value is in the quality of the connections, not the number of messages.", "No. La comunidad es intencional, no ruidosa. El valor está en la calidad de las conexiones, no en la cantidad de mensajes.")}</span></p></details>
<details><summary><span class={lang}>{L("Do I need good English or Spanish?", "¿Necesito buen inglés o buen español?")}</span></summary><p><span class={lang}>{L("No. You can speak imperfect English and imperfect Spanish. Nobody needs to be perfect to belong.", "No. Puedes hablar un inglés y un español imperfectos. Nadie necesita ser perfecta para pertenecer.")}</span></p></details>
<details><summary><span class={lang}>{L("How much does it cost?", "¿Cuánto cuesta?")}</span></summary><p><span class={lang}>{L("We will share prices and founding member details when membership opens. Join the waitlist to hear first.", "Compartiremos los precios y los detalles para miembros fundadoras cuando abra la membresía. Únete a la lista de espera para enterarte primero.")}</span></p></details>
<details><summary><span class={lang}>{L("Can I try SheWins before I join?", "¿Puedo probar SheWins antes de unirme?")}</span></summary><p><span class={lang}>{L("Yes. There is a free community event every month.", "Sí. Hay un evento gratuito de comunidad cada mes.")}</span></p></details>
<details><summary><span class={lang}>{L("Who is it for?", "¿Para quién es?")}</span></summary><p><span class={lang}>{L("Women who want to grow: starting something, changing career, growing a business or looking for community.", "Mujeres que quieren crecer: empezando algo, cambiando de carrera, haciendo crecer un negocio o buscando comunidad.")}</span></p></details>
</div></section>
<section class="s-red formband on-d" id="waitlist"><div class="w"><div class="fgrid">
<div><p class="lab"><span class={lang}>{L("Waitlist", "Lista de espera")}</span></p><h2 class="xl" style="margin-top:18px"><span class={lang}>{L("Be first in line.", "Sé la primera.")}</span></h2><p class="lead" style="margin-top:22px"><span class={lang}>{L("We will email you when membership opens, with founding member details.", "Te escribiremos cuando abra la membresía, con los detalles para miembros fundadoras.")}</span></p></div>
<div>
<form class="form" data-form="waitlist" novalidate><input aria-hidden="true" autocomplete="off" id="w-website" name="website" style="position:absolute;left:-9999px" tabindex="-1" type="text" />
<div class="fld"><label for="w-name"><span class={lang}>{L("Name", "Nombre")}</span></label><input autocomplete="name" id="w-name" maxlength="40" required type="text" /></div>
<div class="fld"><label for="w-mail">Email</label><input autocomplete="email" id="w-mail" required type="email" /></div>
<div class="fld"><label for="w-where"><span class={lang}>{L("Where are you right now?", "¿Dónde estás ahora mismo?")}</span></label><select id="w-where">
<option data-en="Starting something" data-es="Empezando algo">Starting something</option><option data-en="Changing career" data-es="Cambiando de carrera">Changing career</option><option data-en="Growing a business" data-es="Haciendo crecer un negocio">Growing a business</option><option data-en="Looking for opportunities" data-es="Buscando oportunidades">Looking for opportunities</option><option data-en="Looking for community" data-es="Buscando comunidad">Looking for community</option><option data-en="Exploring what is next" data-es="Explorando qué viene">Exploring what is next</option></select></div>
<label class="chk" for="w-ok"><input id="w-ok" required type="checkbox" /><span><span class={lang}>{L("I agree to receive emails about SheWins membership. I can unsubscribe at any time.", "Acepto recibir emails sobre la membresía de SheWins. Puedo darme de baja cuando quiera.")}</span></span></label>
<div><button class="btn b-cream" type="submit"><span class={lang}>{L("Join the waitlist", "Unirme a la lista de espera")}</span><span class="ar"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></button></div>
</form>
<p class="ferr" hidden role="alert"><span class={lang}>{L("Something went wrong. Please try again or email us.", "Algo ha fallado. Inténtalo de nuevo o escríbenos por email.")}</span></p><div class="sent" role="status"><b><span class={lang}>{L("You are on the list.", "Estás en la lista.")}</span></b><p><span class={lang}>{L("We will write to you when membership opens.", "Te escribiremos cuando abra la membresía.")}</span></p></div>
</div>
</div></div></section>
</div>
</Base>
