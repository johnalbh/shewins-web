---
// Shared page shell: the <head> of the original files (SEO, hreflang, social cards, JSON-LD),
// header, menu, footer, cookie banner and the site scripts.
import seoData from '../data/seo.json';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import CookieBanner from '../components/chrome/CookieBanner.astro';
import StickyCta from '../components/chrome/StickyCta.astro';
import { SITE, alternatesFor, type Lang } from '../i18n';
import '../styles/fixes.css';
import '../styles/responsive.css';
import '../styles/controls.css';
import '../styles/motion.css';

export interface Seo {
  title: string;
  description: string;
  ogType: string;
  jsonLd: unknown;
}

interface Props {
  lang: Lang;
  /** Page key in src/data/seo.json; also the body data-route used by the scripts. */
  route: string;
  /** Overrides for pages built from content (blog articles). */
  seo?: Seo;
  path?: string;
}

const { lang, route } = Astro.props;
const page = (seoData as Record<string, { path: string; en: Seo; es: Seo }>)[route];
const seo = Astro.props.seo ?? page[lang];
const alternates = alternatesFor(Astro.props.path ?? page.path);
const abs = (p: string) => SITE + p;
const canonical = abs(alternates[lang]);
const ogImage = `${SITE}/assets/og-image.jpg`;
const [locale, localeAlt] = lang === 'es' ? ['es_ES', 'en_GB'] : ['en_GB', 'es_ES'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport" />
    <meta content="#C7010F" name="theme-color" />
    <link href="/favicon.png" rel="icon" type="image/png" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
    <link as="font" crossorigin="" href="/fonts/archivo-var.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="" href="/fonts/inter-var.woff2" rel="preload" type="font/woff2" />
    <link href="/style.css" rel="stylesheet" />
    <script is:inline src="/config.js"></script>

    <title>{seo.title}</title>
    <meta content={seo.description} name="description" />
    <meta content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" name="robots" />
    <link href={canonical} rel="canonical" />
    <link href={abs(alternates.en)} hreflang="en" rel="alternate" />
    <link href={abs(alternates.es)} hreflang="es" rel="alternate" />
    <link href={abs(alternates.en)} hreflang="x-default" rel="alternate" />
    <meta content={seo.ogType} property="og:type" />
    <meta content="SheWins" property="og:site_name" />
    <meta content={seo.title} property="og:title" />
    <meta content={seo.description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogImage} property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content="SheWins, a business community for women" property="og:image:alt" />
    <meta content={locale} property="og:locale" />
    <meta content={localeAlt} property="og:locale:alternate" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={seo.title} name="twitter:title" />
    <meta content={seo.description} name="twitter:description" />
    <meta content={ogImage} name="twitter:image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
  </head>
  <body data-route={route}>
    <Header lang={lang} route={route} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <StickyCta lang={lang} />
    <Footer lang={lang} />
    <script src="../scripts/site.js"></script>
    <CookieBanner lang={lang} />
    <script src="../scripts/consent.js"></script>
  </body>
</html>
