---
// "Next free event" frame (home and events): the first event from today onwards.
// Same markup and line breaks as the frame in html/index.html.
import { localize, type Lang } from '../../i18n';
import { getEventsByTime, getSettings } from '../../lib/content';
import { dateParts, todayInMadrid } from '../../lib/dates';
import { ARROW } from '../../lib/markup';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
const [{ upcoming }, settings] = await Promise.all([getEventsByTime(), getSettings()]);
const ev = upcoming[0];
const when = dateParts(ev?.date ?? todayInMadrid(), lang);
const language = {
  es: L('Spanish', 'Español'),
  en: L('English', 'Inglés'),
  both: L('English + Spanish', 'Inglés + español'),
};
const topic = ev && L(ev.topicEn, ev.topicEs);
const role = ev && L(ev.hostRoleEn, ev.hostRoleEs);
const time = ev && [ev.startTime, ev.endTime].filter(Boolean).join('–');
---

{ev ? (
<div class="frame"><div class="pn">
<div class="dt"><small><span class={lang}>{when.weekday}</span> · <span class={lang}>{when.monthShort}</span></small>{when.day}</div>
<div>
<p class="lab" style="margin-bottom:14px"><span class={lang}>{L('Next free event', 'Próximo evento gratuito')}</span></p>
<h2>{ev.title}</h2>
<p class="who">{topic && <Fragment><span class={lang}>{topic}</span><br /></Fragment>}{ev.host ? <b>{ev.host}</b> : <span class={lang}>{L('Community session', 'Sesión de comunidad')}</span>}{ev.host && role && <Fragment> · <span class={lang}>{role}</span></Fragment>}</p>
<dl class="facts"><div><dt><span class={lang}>{L('When', 'Cuándo')}</span></dt><dd>{time}</dd></div><div><dt><span class={lang}>{L('Language', 'Idioma')}</span></dt><dd><span class={lang}>{language[ev.language]}</span></dd></div><div><dt><span class={lang}>{L('Where', 'Dónde')}</span></dt><dd>{ev.venue}</dd></div></dl>
<div class="btns"><a class="btn b-red" href={ev.meetupUrl || settings.meetup} rel="noopener" target="_blank"><span class={lang}>{L('RSVP on Meetup', 'Apúntate en Meetup')}</span><Fragment set:html={ARROW} /></a><a class="btn b-line" href={ev.lumaUrl || settings.luma} rel="noopener" target="_blank"><span class={lang}>{L('RSVP on Luma', 'Apúntate en Luma')}</span><Fragment set:html={ARROW} /></a></div>
</div>
</div></div>
) : (
<div class="frame"><div class="pn">
<div class="dt"><small><span class={lang}>{L('Coming soon', 'Muy pronto')}</span></small>{when.monthShort}</div>
<div>
<p class="lab" style="margin-bottom:14px"><span class={lang}>{L('Next free event', 'Próximo evento gratuito')}</span></p>
<h2>{L('New date coming soon.', 'Nueva fecha muy pronto.')}</h2>
<p class="who"><span class={lang}>{L('Follow us on Meetup or Instagram to hear first.', 'Síguenos en Meetup o Instagram para enterarte la primera.')}</span></p>
<div class="btns" style="margin-top:26px"><a class="btn b-red" href={settings.meetup} rel="noopener" target="_blank"><span>Meetup</span><Fragment set:html={ARROW} /></a><a class="btn b-line" href={settings.instagram} rel="noopener" target="_blank"><span>Instagram</span><Fragment set:html={ARROW} /></a></div>
</div>
</div></div>
)}
