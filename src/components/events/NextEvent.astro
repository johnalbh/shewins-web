---
// "Next free event" frame (home): the first free event from today onwards, from the She Wins
// group on Meetup (src/lib/meetup.ts). Same markup and line breaks as the frame in html/index.html,
// plus Meetup's 16:9 image under the date. The events page no longer has the frame: there it
// repeated the red tile of This month right under it (team request, November 2026). Meetup has no field for the speaker's
// role or a second language, so the topic line is Meetup's subtitle as written there. With no
// upcoming free event, or if Meetup did not answer during the build, the frame shows its "new date
// coming soon" state, which points to Meetup.
import { Image } from 'astro:assets';
import { localize, type Lang } from '../../i18n';
import { getEventsByTime, getSettings } from '../../lib/content';
import { dateParts, todayInMadrid } from '../../lib/dates';
import { ARROW, INSTAGRAM, MEETUP } from '../../lib/markup';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
const [{ upcoming }, settings] = await Promise.all([getEventsByTime(), getSettings()]);
// The frame says "free": paid events are skipped.
const ev = upcoming.find((e) => !e.fee);
const when = dateParts(ev?.date ?? todayInMadrid(), lang);
const language = {
  es: L('Spanish', 'Español'),
  en: L('English', 'Inglés'),
};
const time = ev && [ev.startTime, ev.endTime].filter(Boolean).join('–');
const photoAlt = ev && L(`Event poster: ${ev.title}${ev.speaker ? ` with ${ev.speaker}` : ''}`, `Póster del evento: ${ev.title}${ev.speaker ? ` con ${ev.speaker}` : ''}`);
---

{ev ? (
<div class="frame"><div class="pn">
{ev.photo ? (
<div class="dtw"><div class="dt"><small><span class={lang}>{when.weekday}</span> · <span class={lang}>{when.monthShort}</span></small>{when.day}</div><figure><Image src={ev.photo} inferSize alt={photoAlt} widths={[400, 600, 800]} sizes="(min-width: 860px) 30vw, 100vw" class="ev-img" loading="eager" fetchpriority="high" /></figure></div>
) : (
<div class="dt"><small><span class={lang}>{when.weekday}</span> · <span class={lang}>{when.monthShort}</span></small>{when.day}</div>
)}
<div>
<p class="lab" style="margin-bottom:14px"><span class={lang}>{L('Next free event', 'Próximo evento gratuito')}</span></p>
<h2>{ev.title}</h2>
<p class="who">{ev.subtitle && <Fragment>{ev.subtitle}<br /></Fragment>}{ev.speaker ? <b>{ev.speaker}</b> : <span class={lang}>{L('Community session', 'Sesión de comunidad')}</span>}</p>
<dl class="facts"><div><dt><span class={lang}>{L('When', 'Cuándo')}</span></dt><dd>{time}</dd></div><div><dt><span class={lang}>{L('Language', 'Idioma')}</span></dt><dd><span class={lang}>{language[ev.language]}</span></dd></div><div><dt><span class={lang}>{L('Where', 'Dónde')}</span></dt><dd>{ev.venue}</dd></div></dl>
<div class="btns"><a class="btn b-red" href={ev.url} rel="noopener" target="_blank"><Fragment set:html={MEETUP} /><span class={lang}>{L('RSVP on Meetup', 'Apúntate en Meetup')}</span><Fragment set:html={ARROW} /></a><a class="btn b-line" href={settings.luma} rel="noopener" target="_blank"><span class={lang}>{L('RSVP on Luma', 'Apúntate en Luma')}</span><Fragment set:html={ARROW} /></a></div>
</div>
</div></div>
) : (
<div class="frame"><div class="pn">
<div class="dt"><small><span class={lang}>{L('Coming soon', 'Muy pronto')}</span></small>{when.monthShort}</div>
<div>
<p class="lab" style="margin-bottom:14px"><span class={lang}>{L('Next free event', 'Próximo evento gratuito')}</span></p>
<h2>{L('New date coming soon.', 'Nueva fecha muy pronto.')}</h2>
<p class="who"><span class={lang}>{L('Follow us on Meetup or Instagram to hear first.', 'Síguenos en Meetup o Instagram para enterarte la primera.')}</span></p>
<div class="btns" style="margin-top:26px"><a class="btn b-red" href={settings.meetup} rel="noopener" target="_blank"><Fragment set:html={MEETUP} /><span>Meetup</span><Fragment set:html={ARROW} /></a><a class="btn b-line" href={settings.instagram} rel="noopener" target="_blank"><Fragment set:html={INSTAGRAM} /><span>Instagram</span><Fragment set:html={ARROW} /></a></div>
</div>
</div></div>
)}
