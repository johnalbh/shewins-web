---
// "This month" schedule on the events page: the She Wins events on Meetup from the start of the
// current month onwards, with their price when they have one. Each row opens the event on Meetup:
// its title is the link and stretches over the row's text (controls.css). Past / Today / Upcoming
// pills are set in the browser from data-date (scripts/site.js), so the page stays right between
// the daily rebuilds. Same one-line markup as html/events.html. With no events this month, or if
// Meetup did not answer during the build, the section says new dates are on their way.
import { localize, type Lang } from '../../i18n';
import { getEventsByTime, getSettings, type Event } from '../../lib/content';
import { dateParts } from '../../lib/dates';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
const [{ fromMonthStart, today }, settings] = await Promise.all([getEventsByTime(), getSettings()]);
const heading = dateParts(fromMonthStart[0]?.date ?? today, lang);
const LANG_PILL = { es: 'ESP', en: 'ENG' };
const price = (ev: Event) =>
  ev.fee && new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB', { style: 'currency', currency: ev.fee.currency, maximumFractionDigits: 0 }).format(ev.fee.amount);
const rows = fromMonthStart.map((ev) => ({ ev, d: dateParts(ev.date, lang), time: [ev.startTime, ev.endTime].filter(Boolean).join('–'), fee: price(ev) }));
---

<section class="sec s-white"><div class="w"><div class="head"><p class="lab"><span class={lang}>{L('This month', 'Este mes')}</span></p><h2 class="l"><span class={lang}>{L(`${heading.monthName} at She Wins.`, `${heading.monthName} en She Wins.`)}</span></h2></div>{rows.map(({ ev, d, time, fee }) => <article class="ev show go" data-date={ev.date}><div class="d"><small><span class={lang}>{d.weekday}</span>{d.month !== heading.month && <span class={lang}> · {d.monthShort}</span>}</small>{d.day}</div><div><h3><a href={ev.url} rel="noopener" target="_blank">{ev.title}<span aria-hidden="true" class="ext">↗</span></a></h3><p>{ev.speaker || <span class={lang}>{L('Community session', 'Sesión de comunidad')}</span>}<br />{ev.venue}</p><div class="tags"><span class="pill">{time}</span><span class="pill">{LANG_PILL[ev.language]}</span>{fee && <span class="pill">{fee}</span>}<span class="pill r status" hidden></span></div></div></article>)}{rows.length === 0 && <p class="lead"><span class={lang}>{L('New dates are on their way. Follow us on ', 'Las nuevas fechas están en camino. Síguenos en ')}<a href={settings.meetup} rel="noopener" target="_blank">Meetup</a>{L(' or ', ' o ')}<a href={settings.instagram} rel="noopener" target="_blank">Instagram</a>.</span></p>}</div></section>
