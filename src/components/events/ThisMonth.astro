---
// "This month" schedule on the events page: events from the start of the current month onwards.
// Past / Today / Upcoming pills are set in the browser from data-date (scripts/site.js), so the
// page stays right between the daily rebuilds. Same one-line markup as html/events.html.
import Mu from '../lab/Mu.astro';
import { localize, type Lang } from '../../i18n';
import { getEventsByTime, getSettings } from '../../lib/content';
import { dateParts } from '../../lib/dates';

interface Props {
  lang: Lang;
  /** Merge the Meetup events in (lab page). */
  meetup?: boolean;
}

const { lang, meetup = false } = Astro.props;
const { L } = localize(lang);
const [{ fromMonthStart, today }, settings] = await Promise.all([getEventsByTime({ meetup }), getSettings()]);
const heading = dateParts(fromMonthStart[0]?.date ?? today, lang);
const LANG_PILL = { es: 'ESP', en: 'ENG', both: 'ENG + ESP' };
// The price is known only for events that come from Meetup; Keystatic-only events show none, as before.
const price = (ev: (typeof fromMonthStart)[number]) =>
  ev.meetup?.fee && new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB', { style: 'currency', currency: ev.meetup.fee.currency, maximumFractionDigits: 0 }).format(ev.meetup.fee.amount);
const rows = fromMonthStart.map((ev) => ({ ev, d: dateParts(ev.date!, lang), time: [ev.startTime, ev.endTime].filter(Boolean).join('–'), fee: price(ev) }));
---

<section class="sec s-white"><div class="w"><div class="head"><p class="lab"><span class={lang}>{L('This month', 'Este mes')}</span></p><h2 class="l"><span class={lang}>{L(`${heading.monthName} at She Wins.`, `${heading.monthName} en She Wins.`)}</span></h2></div>{rows.map(({ ev, d, time, fee }) => <article class="ev show" data-date={ev.date}><div class="d"><small><span class={lang}>{d.weekday}</span>{d.month !== heading.month && <span class={lang}> · {d.monthShort}</span>}</small><Mu on={ev.from?.date}>{d.day}</Mu></div><div><h3><Mu on={ev.from?.title}>{ev.title}</Mu></h3><p>{ev.host ? <Mu on={ev.from?.host}>{ev.host}</Mu> : <span class={lang}>{L('Community session', 'Sesión de comunidad')}</span>}<br /><Mu on={ev.from?.venue}>{ev.venue}</Mu></p><div class="tags"><span class="pill"><Mu on={ev.from?.time}>{time}</Mu></span><span class="pill"><Mu on={ev.from?.language}>{LANG_PILL[ev.language]}</Mu></span>{fee && <span class="pill"><Mu on={ev.from?.fee}>{fee}</Mu></span>}<span class="pill r status" hidden></span></div></div></article>)}{rows.length === 0 && <p class="lead"><span class={lang}>{L('New dates are on their way. Follow us on ', 'Las nuevas fechas están en camino. Síguenos en ')}<a href={settings.meetup} rel="noopener" target="_blank">Meetup</a>{L(' or ', ' o ')}<a href={settings.instagram} rel="noopener" target="_blank">Instagram</a>.</span></p>}</div></section>
