---
// The three most recent past events of the She Wins group on Meetup (home "Recent events" and
// events page "Past events"), shown oldest to newest like the original row. Each shows Meetup's
// own image and, right of its title, two small red squares: the event on Meetup and She Wins on
// Instagram (controls.css). Meetup's images are 16:9 posters with their own text, so they are shown
// whole, never cropped; they are downloaded and converted to WebP at build time. If Meetup did not
// answer during the build there is no row.
import { Image } from 'astro:assets';
import { localize, type Lang } from '../../i18n';
import { getSettings } from '../../lib/content';
import { getEventsByTime, posterAlt } from '../../lib/events';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
const [{ past }, settings] = await Promise.all([getEventsByTime(), getSettings()]);
const recent = past
  .filter((ev) => ev.photo)
  .slice(0, 3)
  .reverse();
---

{recent.length > 0 && (
  <div class="posters three wide">
    {recent.map((ev) => (
      <figure>
        <a aria-hidden="true" href={ev.url} rel="noopener" tabindex="-1" target="_blank">
          <Image
            src={ev.photo!}
            inferSize
            alt={posterAlt(ev, lang)}
            widths={[400, 600, 800]}
            sizes="(min-width: 760px) 33vw, 100vw"
            loading="lazy"
          />
        </a>
        <figcaption>
          {ev.title}
          <div class="ev-icons">
            <a aria-label={`Meetup: ${ev.title}`} href={ev.url} rel="noopener" target="_blank" title="Meetup"><Icon name="meetup" /></a>
            <a
              aria-label={L('She Wins on Instagram', 'She Wins en Instagram')}
              href={settings.instagram}
              rel="noopener"
              target="_blank"
              title="Instagram"
            ><Icon name="instagram" /></a>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
)}
