---
// The three most recent past events (home and events), shown oldest to newest like the original row.
// Images are resized and converted to WebP at build time.
//
// With `meetup` (the home, team request of November 2026), they are the events of the She Wins
// group on Meetup, with Meetup's own image and, right of the title, two small red squares with
// the Meetup and Instagram marks: the event on Meetup and She Wins on Instagram.
// Meetup's images are 16:9 posters with their own text, so they are shown whole, never cropped to
// the 3:4 of the Keystatic posters. If Meetup did not answer during the build, the row falls back
// to the Keystatic posters, as before, rather than leave the section empty.
//
// Without it (the events page), the Keystatic posters, each linking to its Instagram post: the same
// one-line markup as html/events.html.
import { Image } from 'astro:assets';
import { localize, type Lang } from '../../i18n';
import { getEventsByTime, getSettings, type Event } from '../../lib/content';
import { getImage } from '../../lib/images';
import { INSTAGRAM, MEETUP } from '../../lib/markup';

interface Props {
  lang: Lang;
  /** Show the latest events from Meetup instead of the Keystatic posters. */
  meetup?: boolean;
}

const { lang, meetup = false } = Astro.props;
const { L } = localize(lang);
const [{ past }, settings] = await Promise.all([getEventsByTime(), getSettings()]);
const posters = past
  .map((ev) => ({ ev, image: getImage(ev.poster) }))
  .filter((p) => p.image)
  .slice(0, 3)
  .reverse();
const fromMeetup = meetup
  ? (await getEventsByTime({ meetup: true })).past
      .filter((ev) => ev.meetup?.photo)
      .slice(0, 3)
      .reverse()
  : [];
const altText = (ev: Event) => {
  const what = ev.posterAlt || (ev.host ? L(`${ev.title} with ${ev.host}`, `${ev.title} con ${ev.host}`) : ev.title);
  return L(`Event poster: ${what}`, `Póster del evento: ${what}`);
};
---

{fromMeetup.length > 0 ? (
<div class="posters three wide">{fromMeetup.map((ev) => <figure><a aria-hidden="true" href={ev.meetup!.url} rel="noopener" tabindex="-1" target="_blank"><Image src={ev.meetup!.photo!} inferSize alt={altText(ev)} widths={[400, 600, 800]} sizes="(min-width: 760px) 33vw, 100vw" loading="lazy" /></a><figcaption>{ev.title}<div class="ev-icons"><a aria-label={`Meetup: ${ev.title}`} href={ev.meetup!.url} rel="noopener" target="_blank" title="Meetup"><Fragment set:html={MEETUP} /></a><a aria-label={L('She Wins on Instagram', 'She Wins en Instagram')} href={ev.instagramUrl || settings.instagram} rel="noopener" target="_blank" title="Instagram"><Fragment set:html={INSTAGRAM} /></a></div></figcaption></figure>)}</div>
) : (
<div class="posters three">{posters.map(({ ev, image }) => <figure><a href={ev.instagramUrl || settings.instagram} rel="noopener" target="_blank"><Image src={image!} alt={altText(ev)} widths={[360, 540, 720]} sizes="(min-width: 760px) 33vw, 100vw" loading="lazy" /></a><figcaption>{ev.title} <span aria-hidden="true">↗</span></figcaption></figure>)}</div>
)}
