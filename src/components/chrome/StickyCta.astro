---
// The "Join the waitlist" bar at the foot of the screen. Rendered on every page; sticky-cta.js
// shows it on Membership only. Markup from html/index.html.
import { localize, type Lang } from '../../i18n';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
---

<div class="sticky-cta" id="sticky">
  <button class="btn b-red" data-scroll="waitlist" type="button">
    <span class={lang}>{L('Join the waitlist', 'Unirme a la lista de espera')}</span>
    <span class="ar"><Icon name="arrow" /></span>
  </button>
</div>
