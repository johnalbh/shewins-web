---
// The Letter invitation: a small card that asks visitors to subscribe and links to /letter
// (team request, November 2026). It has no form of its own, so the Letter's em-* ids never repeat
// on a page. It is left out where it would get in the way: the Letter page itself, Membership
// (the waitlist is the action there), the legal pages and the 404. When it shows and how it
// remembers being closed is in src/scripts/letter-invite.js.
import { localize, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  route: string;
}

const SKIP = ['letter', 'membership', 'privacy', 'legal', 'cookies', '404'];

const { lang, route } = Astro.props;
const { L, u } = localize(lang);
---

{!SKIP.includes(route) && (
<aside aria-labelledby="invite-t" aria-modal="false" class="invite" hidden id="letter-invite" role="dialog">
<button aria-label={L("Close", "Cerrar")} class="x" data-invite-close type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 16 16"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg></button>
<p class="lab"><span class={lang}>{L("The She Wins Letter", "La Letter de She Wins")}</span></p>
<p class="invite-t" id="invite-t"><span class={lang}>{L("Psst. The best part of She Wins fits in one email.", "Psst. Lo mejor de She Wins cabe en un email.")}</span></p>
<p class="invite-d"><span class={lang}>{L("One idea, one tool, one woman, one opportunity. Once a month, in English or Spanish.", "Una idea, una herramienta, una mujer, una oportunidad. Una vez al mes, en inglés o en español.")}</span></p>
<a class="btn b-cream" data-invite-go href={u("/letter")}><span class={lang}>{L("Subscribe", "Suscribirme")}</span><span class="ar"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
</aside>
)}
