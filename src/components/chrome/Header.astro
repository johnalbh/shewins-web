---
// Skip link, site header (logo, main navigation with the current page marked, EN / ES buttons,
// the waitlist button) and the phone menu, which navigation.js opens. Markup from html/index.html.
import { localize, type Lang } from '../../i18n';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  route: string;
  /** Same page in each language, for the EN / ES buttons. */
  alternates: { en: string; es: string };
}

const { lang, route, alternates } = Astro.props;
const { L, u } = localize(lang);
const section = route.startsWith('post-') ? 'blog' : route;
const current = (r: string) => (r === section ? 'page' : undefined);
---

<a class="skip" href="#main"><span class={lang}>{L('Skip to content', 'Saltar al contenido')}</span></a>
<header class="hdr">
  <div class="in">
    <a aria-label="She Wins" class="brand" href={u('/')}><img alt="She Wins" height="160" src="/assets/logo-red.png" width="142" /></a>
    <nav aria-label="Main" class="nav">
      <a aria-current={current('home')} href={u('/')}>{L('Home', 'Inicio')}</a>
      <a aria-current={current('about')} href={u('/about')}><span class={lang}>{L('About', 'Sobre nosotras')}</span></a>
      <a aria-current={current('events')} href={u('/events')}><span class={lang}>{L('Events', 'Eventos')}</span></a>
      <a aria-current={current('membership')} href={u('/membership')}><span class={lang}>{L('Membership', 'Membresía')}</span></a>
      <a aria-current={current('partners')} href={u('/partners')}><span class={lang}>{L('Partners', 'Colabora')}</span></a>
      <a aria-current={current('blog')} href={u('/blog')}>Blog</a>
    </nav>
    <div aria-label="Language" class="lang" role="group">
      <button aria-pressed={lang === 'en' ? 'true' : 'false'} data-href={alternates.en} data-lang="en" type="button">EN</button>
      <button aria-pressed={lang === 'es' ? 'true' : 'false'} data-href={alternates.es} data-lang="es" type="button">ES</button>
    </div>
    <a class="btn b-red hcta" href={u('/membership') + '#waitlist'}>
      <span class={lang}>{L('Join the waitlist', 'Lista de espera')}</span>
      <span class="ar"><Icon name="arrow" /></span>
    </a>
    <button aria-controls="menu" aria-expanded="false" aria-label="Menu" class="burger" type="button">
      <span>Menu</span>
      <i></i>
    </button>
  </div>
</header>
<div class="menu" hidden id="menu">
  <div class="top">
    <img alt="She Wins" height="160" src="/assets/logo-cream.png" width="142" />
    <button aria-label="Close menu" class="x" type="button"><Icon name="close" /></button>
  </div>
  <nav aria-label="Menu">
    <a href={u('/')}>{L('Home', 'Inicio')}</a>
    <a href={u('/about')}><span class={lang}>{L('About', 'Sobre nosotras')}</span></a>
    <a href={u('/events')}><span class={lang}>{L('Events', 'Eventos')}</span></a>
    <a href={u('/membership')}>
      <span class={lang}>{L('Membership', 'Membresía')}</span>{' '}
      <small><span class={lang}>{L('Soon', 'Pronto')}</span></small>
    </a>
    <a href={u('/partners')}><span class={lang}>{L('Partners', 'Colabora')}</span></a>
    <a href={u('/blog')}>Blog</a>
  </nav>
  <div class="mf">
    <span class="script"><span class={lang}>{L('Move forward. Together.', 'Avanza. Juntas.')}</span></span>
    <p class="lab">
      <span class={lang}>{L('A business community for women', 'Una comunidad de negocios para mujeres')}</span>
    </p>
  </div>
</div>
