---
// Lab page (/lab/meetup): marks a value that came from Meetup, styled by src/styles/lab.css.
// When `on` is empty (every page but the lab) it renders the value alone, so the markup of the
// live pages does not change.
interface Props {
  /** true: taken from Meetup; "guess": worked out from Meetup's text (the language). */
  on?: boolean | 'guess';
}

const { on } = Astro.props;
---

{on ? <span class="mu" data-mu={on === 'guess' ? 'guess' : undefined} title={on === 'guess' ? 'Guessed from Meetup' : 'From Meetup'}><slot /></span> : <slot />}
