---
// Lab page only (/lab/meetup): says what the page is and, for each event of the month, how its
// Meetup title was turned into the site's, so the team can judge the integration before it goes live.
import { localize, type Lang } from '../../i18n';
import { getEventsByTime } from '../../lib/content';
import { dateParts } from '../../lib/dates';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { L } = localize(lang);
const { fromMonthStart, upcoming, meetupLoaded } = await getEventsByTime({ meetup: true });
const next = upcoming.find((e) => e.free !== false);
const built = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' }).format(new Date());
---

<section class="sec s-cream"><div class="w">
<div class="head"><p class="lab"><span class={lang}>{L('Lab · hidden page', 'Laboratorio · página oculta')}</span></p><h2 class="l"><span class={lang}>{L('Events from Meetup, in the She Wins format.', 'Eventos de Meetup, en el formato de She Wins.')}</span></h2></div>
<p class="lead"><span class={lang}>{L(
  `A copy of the home page whose events come only from Meetup, read when the site is built; the Keystatic events are not used. It is not in the menu, the sitemap or search engines. Built ${built}.`,
  `Una copia de la home cuyos eventos vienen solo de Meetup, leídos al construir la web; los eventos de Keystatic no se usan. No está en el menú, ni en el sitemap, ni en los buscadores. Construida el ${built}.`,
)}</span></p>
{meetupLoaded === false && <p class="lead"><b><span class={lang}>{L('Meetup did not answer during this build, so there are no events.', 'Meetup no respondió durante este build, así que no hay eventos.')}</span></b></p>}
{fromMonthStart.map((ev) => {
  const d = dateParts(ev.date!, lang);
  return <div class="rw"><p class="lab"><span class={lang}>{d.weekday} {d.day} {d.monthShort}</span></p><div><h3>{ev.title}</h3><p>{ev.meetup && ev.meetup.rawTitle !== ev.title && <Fragment><span class={lang}>{L('On Meetup: ', 'En Meetup: ')}</span>“{ev.meetup.rawTitle}”<br /></Fragment>}<span class={lang}>{L('Language guessed from the text.', 'Idioma deducido del texto.')}</span></p><div class="tags">{ev.free === false && <span class="pill"><span class={lang}>{L('Paid', 'De pago')}</span></span>}{ev === next && <span class="pill r"><span class={lang}>{L('Next free event', 'Próximo evento gratuito')}</span></span>}</div></div></div>;
})}
</div></section>
