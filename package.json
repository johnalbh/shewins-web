{
  "name": "shewins-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-brand-font.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "audit:responsive": "node scripts/responsive-audit.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/vercel": "11.0.16",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@markdoc/markdoc": "0.4.0",
    "astro": "7.4.2",
    "botid": "1.5.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
