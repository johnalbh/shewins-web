# Brevo (forms and newsletter). Without BREVO_API_KEY, `npm run dev` only logs form submissions.
BREVO_API_KEY=
# Brevo list ids (Contacts > Lists)
BREVO_LIST_WAITLIST=
BREVO_LIST_NEWSLETTER=
# Double opt-in template id (Templates; it must contain the {{ doubleoptin }} link)
BREVO_DOI_TEMPLATE=
# Notifications: sender (a verified Brevo sender on shewins.es) and recipient
FORM_FROM=web@shewins.es
FORM_TO=agnieszka@shewins.es
# Licensed brand font (Vercel Blob URL), downloaded before each build. Not needed when the file
# is already in public/fonts locally.
BRAND_FONT_URL=
