# Forms (src/pages/api/form.ts). Without these keys, `npm run dev` only logs form submissions.

# MailerLite: newsletter and membership waitlist lists.
#   Integrations > MailerLite API > Generate new token
MAILERLITE_API_KEY=
#   Subscribers > Groups: the IDs of the "Newsletter" and "Waitlist" groups
MAILERLITE_GROUP_NEWSLETTER=
MAILERLITE_GROUP_WAITLIST=
#   The ID of the "Test" group. In `npm run dev` and on Vercel preview deployments, when it is set,
#   every signup goes to this group instead of the two above, so tests never reach real
#   subscribers. Production ignores it.
MAILERLITE_GROUP_TEST=
#   Also in MailerLite: Settings > Subscribe settings > "Double opt-in for API and integrations"
#   on, and custom fields "language" and "stage" (Subscribers > Fields).

# MailerSend: notification emails to the team (contact form, new waitlist signups).
#   Domains: verify shewins.es; API tokens: create one with "Email" access
MAILERSEND_API_KEY=
# Sender (must be on the domain verified in MailerSend) and recipient
FORM_FROM=web@shewins.es
FORM_TO=agnieszka@shewins.es

# Licensed brand font (Vercel Blob URL), downloaded before each build. Not needed when the file
# is already in public/fonts locally.
BRAND_FONT_URL=
